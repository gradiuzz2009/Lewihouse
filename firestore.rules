rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions & Enterprise RBAC (Custom Claims + Verified Email)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role verification primarily powered by Firebase Auth Custom Claims (no extra read billing)
    function isOwnerOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'manager' ||
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email in ['fauziealiakhmad@gmail.com', 'admin@lewihouse.com', 'owner@lewihouse.com'])
      );
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // =========================================================================
    // Root Users Collection (Anti-Privilege Escalation)
    // =========================================================================
    match /users/{userId} {
      allow read: if isSelf(userId) || isOwnerOrAdmin();
      
      // Prevent users from granting themselves 'admin'/'owner' roles
      allow create: if isAuthenticated() && (
        isOwnerOrAdmin() ||
        (isSelf(userId) &&
         request.resource.data.role == 'tenant' &&
         request.resource.data.keys().hasOnly(['email', 'name', 'role', 'residentId', 'propertyId', 'createdAt']))
      );

      // Prevent users from elevating roles on document update
      allow update: if isOwnerOrAdmin() || (
        isSelf(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'id'])
      );

      allow delete: if isOwnerOrAdmin();
    }

    // =========================================================================
    // Scoped Property Collections (/properties/lewi_house_main/...)
    // =========================================================================
    match /properties/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin();

      // --- Kosan Rooms ---
      match /rooms/{roomId} {
        allow read: if isAuthenticated();
        allow write: if isOwnerOrAdmin();
      }

      // --- Residents / Tenants ---
      match /residents/{residentId} {
        allow read: if isOwnerOrAdmin() ||
          (isAuthenticated() && (
            resource.data.userId == request.auth.uid ||
            resource.data.email == request.auth.token.email ||
            request.auth.uid == residentId
          ));
        allow write: if isOwnerOrAdmin();
      }

      // --- Rent & Utility Payments ---
      match /payments/{paymentId} {
        allow read: if isOwnerOrAdmin() ||
          (isAuthenticated() && (
            resource.data.tenantId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ));
        allow create: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          (
            (request.resource.data.tenantId == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
            request.resource.data.amount is number && request.resource.data.amount > 0 &&
            isValidString(request.resource.data.roomNumber, 1, 10)
          )
        );
        allow update, delete: if isOwnerOrAdmin();
      }

      // --- Invoices / Bills ---
      match /bills/{billId} {
        allow read: if isOwnerOrAdmin() ||
          (isAuthenticated() && (
            resource.data.tenantId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ));
        allow write: if isOwnerOrAdmin();
      }

      // --- Electricity Meters & Readings ---
      match /electricity_meters/{meterId} {
        allow read: if isAuthenticated();
        allow write: if isOwnerOrAdmin();
      }

      // --- Electricity Tokens (Restricted creation to Admin/Owner) ---
      match /electricity_tokens/{tokenId} {
        allow read: if isAuthenticated();
        allow create: if isOwnerOrAdmin();
        allow update, delete: if isOwnerOrAdmin();
      }

      // --- Maintenance & Complaints Tickets ---
      match /maintenance_tickets/{ticketId} {
        allow read: if isOwnerOrAdmin() ||
          (isAuthenticated() && (
            resource.data.tenantId == request.auth.uid ||
            resource.data.residentId == request.auth.uid
          ));
        
        allow create: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          (
            (request.resource.data.tenantId == request.auth.uid || request.resource.data.residentId == request.auth.uid) &&
            isValidString(request.resource.data.title, 3, 100) &&
            isValidString(request.resource.data.description, 5, 500) &&
            isValidString(request.resource.data.roomNumber, 1, 10)
          )
        );

        allow update: if isOwnerOrAdmin() ||
          (isAuthenticated() && (
            (resource.data.tenantId == request.auth.uid || resource.data.residentId == request.auth.uid) &&
            // Tenants can only update satisfaction rating and comments
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'feedbackComment', 'updatedAt'])
          ));

        allow delete: if isOwnerOrAdmin();
      }

      // --- Service Feedback & Surveys ---
      match /service_feedbacks/{feedbackId} {
        allow read: if isOwnerOrAdmin() || (isAuthenticated() && resource.data.tenantId == request.auth.uid);
        allow create: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          (
            request.resource.data.tenantId == request.auth.uid &&
            request.resource.data.rating is int &&
            request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
            isValidOptionalString(request.resource.data.comment, 500)
          )
        );
        allow update, delete: if isOwnerOrAdmin();
      }

      match /satisfaction_surveys/{surveyId} {
        allow read: if isOwnerOrAdmin() || (isAuthenticated() && resource.data.tenantId == request.auth.uid);
        allow create: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          (
            request.resource.data.tenantId == request.auth.uid &&
            request.resource.data.overallRating is int &&
            request.resource.data.overallRating >= 1 && request.resource.data.overallRating <= 5 &&
            isValidOptionalString(request.resource.data.suggestions, 1000)
          )
        );
        allow update, delete: if isOwnerOrAdmin();
      }

      // --- Announcements & Notifications ---
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          resource.data.recipientResidentId == null ||
          resource.data.recipientResidentId == "" ||
          resource.data.recipientResidentId == request.auth.uid
        );
        allow create, delete: if isOwnerOrAdmin();
        allow update: if isAuthenticated() && (
          isOwnerOrAdmin() ||
          (resource.data.recipientResidentId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
        );
      }

      // --- Real-time Chat Threads & Messages ---
      match /chat_threads/{threadId} {
        allow read, write: if true;
      }

      match /chats/{threadId}/messages/{messageId} {
        allow read: if true;
        allow create: if (
          (request.resource.data.text is string && request.resource.data.text.size() <= 2000) ||
          request.resource.data.attachment != null
        );
        allow update: if true;
        allow delete: if isOwnerOrAdmin();
      }

      match /chats/{threadId}/typing/{userId} {
        allow read, write: if true;
      }

      match /chats/{threadId}/presence/{userId} {
        allow read, write: if true;
      }
    }
  }
}
